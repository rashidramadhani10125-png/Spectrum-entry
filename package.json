{
  "name": "spectrum-client-registration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server.ts",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node build/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
